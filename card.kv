#:import dp kivy.metrics.dp

<CardFrame>:
    orientation: "vertical"
    spacing: dp(3)
    padding: dp(3)
    canvas.before:
        Color:
            rgba: 0.055, 0.065, 0.07, 1
        Rectangle:
            pos: self.pos
            size: self.size

<CardControls>:
    size_hint_y: None
    height: dp(28)
    spacing: dp(3)

<CardPrimaryButton>:
    font_size: dp(10)
    padding: dp(1), 0
    background_normal: ''
    background_down: ''
    background_color: 0.78, 0.61, 0.31, 1
    color: 0.055, 0.075, 0.09, 1
    bold: True

<CardActionButton>:
    font_size: dp(10)
    padding: dp(1), 0
    background_normal: ''
    background_down: ''
    background_color: 0.20, 0.23, 0.24, 1
    color: 0.94, 0.92, 0.85, 1
