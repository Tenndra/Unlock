#:import dp kivy.metrics.dp

<AppRoot>:
    orientation: "vertical"
    spacing: dp(2)
    padding: dp(5)
    canvas.before:
        Color:
            rgba: 0.055, 0.075, 0.09, 1
        Rectangle:
            pos: self.pos
            size: self.size

<BodyPanel>:
    spacing: dp(5)

<ToolbarPanel>:
    size_hint_y: None
    height: dp(58)
    padding: dp(12), dp(7)
    spacing: dp(9)
    canvas.before:
        Color:
            rgba: 0.09, 0.12, 0.14, 1
        Rectangle:
            pos: self.pos
            size: self.size

<SidebarPanel>:
    orientation: "vertical"
    size_hint_x: None
    width: dp(112)
    padding: dp(7)
    spacing: dp(5)
    canvas.before:
        Color:
            rgba: 0.09, 0.12, 0.14, 1
        Rectangle:
            pos: self.pos
            size: self.size

<ToolbarTitle>:
    size_hint_x: None
    width: dp(280)
    text_size: self.size
    color: 0.94, 0.92, 0.85, 1
    bold: True
    font_size: dp(16)
    halign: 'left'
    valign: 'middle'
    markup: True

<SectionTitle>:
    size_hint_y: None
    height: dp(28)
    color: 0.78, 0.61, 0.31, 1
    bold: True
    font_size: dp(11)
    markup: True

<BrassButton>:
    size_hint_x: None
    width: dp(120)
    background_normal: ''
    background_down: ''
    background_color: 0.78, 0.61, 0.31, 1
    color: 0.055, 0.075, 0.09, 1
    bold: True
    font_size: dp(12)

<DarkButton>:
    size_hint_y: None
    height: dp(42)
    background_normal: ''
    background_down: ''
    background_color: 0.14, 0.18, 0.20, 1
    color: 0.94, 0.92, 0.85, 1
    font_size: dp(12)

<HelpButton>:
    size_hint_x: None
    width: dp(90)
    background_normal: ''
    background_down: ''
    background_color: 0.14, 0.18, 0.20, 1
    color: 0.94, 0.92, 0.85, 1
    font_size: dp(12)

<DeckCardButton>:
    background_normal: ''
    background_down: ''
    background_color: 0.14, 0.18, 0.20, 1
    color: 0.94, 0.92, 0.85, 1
    halign: 'center'
    valign: 'middle'
    padding: 0, 0

<Spinner>:
    size_hint_x: None
    width: dp(280)
    background_normal: ''
    background_color: 0.14, 0.18, 0.20, 1
    color: 0.94, 0.92, 0.85, 1
    font_size: dp(13)

<Popup>:
    title_color: 0.94, 0.92, 0.85, 1
    title_size: dp(15)
    separator_color: 0.78, 0.61, 0.31, 1
    background_color: 0.09, 0.12, 0.14, 1
